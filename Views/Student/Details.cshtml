@model StudentCourseRegistration.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2 class="text-center mb-4">Student Details</h2>

<div class="card shadow mx-auto" style="max-width: 550px;">
    <div class="card-header bg-primary text-white">
        Student Information
    </div>

    <div class="card-body">

        <h5>Student ID: @Model.Id</h5>

        <hr />

        <p>
            <strong>Name:</strong> @Model.Name
        </p>

        <p>
            <strong>Email:</strong> @Model.Email
        </p>

        <p>
            <strong>Course:</strong> @Model.Course
        </p>

        <p>
            <strong>Semester:</strong> @Model.Semester
        </p>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Student List
        </a>

    </div>
</div>
